# Copia este archivo a ".env.local" y completa con tus valores reales.
# Nunca subas ".env.local" al repositorio.

# Supabase (Project Settings > API)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# Cloudflare Turnstile (dash.cloudflare.com > Turnstile) -- protección
# anti-spam del formulario "Comparte tu memoria".
# Site Key: pública, se usa en el navegador.
VITE_TURNSTILE_SITE_KEY=tu-turnstile-site-key
# Secret Key: privada, solo la usa api/submit-memory.js en el servidor.
# NUNCA debe llevar el prefijo VITE_ (eso la expondría al navegador).
TURNSTILE_SECRET_KEY=tu-turnstile-secret-key

# Panel de moderación (/moderar) -- todas privadas, solo servidor.
# service_role key de Supabase (Project Settings > API Keys): salta RLS,
# nunca debe ir en el frontend.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
# Contraseña para entrar a /moderar.
MODERATION_PASSWORD=elige-una-contraseña
# Secreto largo y aleatorio que firma la cookie de sesión del panel
# (generar una vez con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
MODERATION_SESSION_SECRET=un-secreto-aleatorio-largo
