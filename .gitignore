# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Environment variables (Supabase keys, etc.)
.env

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.vercel

# Claude Code: ignore local/session files, but keep project skills
# (.claude/skills) tracked so they travel with the repo.
.claude/*
!.claude/skills

# Supabase CLI local cache
supabase/.temp

# Generado por scripts/build-memorias.mjs a partir de
# Documentos/Memorias_Libros.docx en cada build/dev (ver "prebuild"/
# "predev" en package.json) -- no se commitea, siempre se regenera.
src/data/memorias.json

# Archivos temporales de Word (se crean mientras un .docx está abierto),
# nunca se deben commitear.
Documentos/~$*
Documentos/~WRL*.tmp
